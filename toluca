<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Historia del Club Deportivo Toluca</title>

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family: Arial, sans-serif;
    }

    body{
        background: linear-gradient(to bottom,#8B0000,#ffffff);
        color:#333;
    }

    header{
        text-align:center;
        background:#b30000;
        color:white;
        padding:30px;
    }

    header img{
        width:120px;
        margin-top:10px;
    }

    .contenedor{
        width:90%;
        max-width:1200px;
        margin:auto;
        padding:20px;
    }

    .intro{
        background:white;
        padding:20px;
        border-radius:15px;
        margin:20px 0;
        box-shadow:0 0 10px rgba(0,0,0,0.3);
    }

    .timeline{
        display:flex;
        flex-wrap:wrap;
        justify-content:center;
        gap:20px;
        margin-top:20px;
    }

    .evento{
        width:280px;
        background:white;
        border-radius:15px;
        overflow:hidden;
        box-shadow:0 0 10px rgba(0,0,0,0.3);
        transition:transform 0.3s;
    }

    .evento:hover{
        transform:scale(1.05);
    }

    .evento img{
        width:100%;
        height:180px;
        object-fit:cover;
    }

    .evento h3{
        background:#b30000;
        color:white;
        padding:10px;
        text-align:center;
    }

    .evento p{
        padding:15px;
        display:none;
    }

    button{
        display:block;
        margin:10px auto 20px;
        padding:10px 20px;
        background:#b30000;
        color:white;
        border:none;
        border-radius:8px;
        cursor:pointer;
    }

    button:hover{
        background:#8B0000;
    }

    .galeria{
        margin-top:40px;
        text-align:center;
    }

    .galeria img{
        width:250px;
        margin:10px;
        border-radius:15px;
        transition:0.4s;
    }

    .galeria img:hover{
        transform:scale(1.1);
    }

    footer{
        background:#111;
        color:white;
        text-align:center;
        padding:20px;
        margin-top:30px;
    }
</style>
</head>
<body>

<header>
    <h1>Historia del Club Deportivo Toluca</h1>
    <img src="imagenes/escudo.png" alt="Escudo Toluca">
</header>

<div class="contenedor">

    <div class="intro">
        <h2>Los Diablos Rojos</h2>
        <p>
            El Club Deportivo Toluca fue fundado el 12 de febrero de 1917 y es uno de los equipos más exitosos del fútbol mexicano.
            Conocido como "Los Diablos Rojos", ha conquistado múltiples campeonatos de liga y ha dejado una huella importante en el deporte nacional.
        </p>
    </div>

    <h2 style="text-align:center;color:white;">Línea del Tiempo Interactiva</h2>

    <div class="timeline">

        <div class="evento">
            <img src="imagenes/fundacion.jpg" alt="Fundación">
            <h3>1917 - Fundación</h3>
            <button onclick="mostrarTexto(0)">Ver más</button>
            <p>
                El Club Deportivo Toluca fue fundado en la ciudad de Toluca, Estado de México.
            </p>
        </div>

        <div class="evento">
            <img src="imagenes/primer_titulo.jpg" alt="Primer título">
            <h3>1967 - Primer Campeonato</h3>
            <button onclick="mostrarTexto(1)">Ver más</button>
            <p>
                Toluca consiguió uno de sus primeros grandes campeonatos consolidándose como un club importante.
            </p>
        </div>

        <div class="evento">
            <img src="imagenes/cardozo.jpg" alt="Cardozo">
            <h3>Era Cardozo</h3>
            <button onclick="mostrarTexto(2)">Ver más</button>
            <p>
                José Saturnino Cardozo se convirtió en una leyenda del club y uno de los máximos goleadores de la Liga MX.
            </p>
        </div>

        <div class="evento">
            <img src="imagenes/campeon.jpg" alt="Campeón">
            <h3>Campeonatos Modernos</h3>
            <button onclick="mostrarTexto(3)">Ver más</button>
            <p>
                Durante las décadas recientes, Toluca se mantuvo entre los equipos más ganadores del fútbol mexicano.
            </p>
        </div>

    </div>

    <div class="galeria">
        <h2 style="color:white;">Galería Histórica</h2>

        <img src="imagenes/estadio.jpg" alt="Estadio Nemesio Diez">
        <img src="imagenes/equipo.jpg" alt="Equipo Toluca">
        <img src="imagenes/aficion.jpg" alt="Afición">

    </div>

    <div class="intro">
        <h2>¿Sabías qué?</h2>
        <button onclick="datoCurioso()">Mostrar dato curioso</button>
        <p id="dato"></p>
    </div>

</div>

<footer>
    <p>Club Deportivo Toluca - Historia Interactiva</p>
</footer>

<script>

function mostrarTexto(indice){
    let textos = document.querySelectorAll(".evento p");

    if(textos[indice].style.display === "block"){
        textos[indice].style.display = "none";
    }else{
        textos[indice].style.display = "block";
    }
}

function datoCurioso(){

    let datos = [
        "Toluca juega sus partidos en el Estadio Nemesio Diez.",
        "José Saturnino Cardozo es uno de los máximos ídolos del club.",
        "Toluca fue uno de los equipos dominantes del fútbol mexicano en los años 90 y 2000.",
        "El apodo 'Diablos Rojos' es reconocido en todo México."
    ];

    let aleatorio = Math.floor(Math.random()*datos.length);

    document.getElementById("dato").innerHTML = datos[aleatorio];
}

</script>

</body>
</html>
